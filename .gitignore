# ── Godot 引擎缓存（必排除，几百 MB 且每个版本都不一样）
.godot/
*.tmpdir/
.config.gd.*.tmpdir/

# ── 导出产物（安装包/可执行文件走 GitHub Releases，不走 git）
异形入侵*.exe
*.exe
*.pck
*.zip
build/
dist/

# ── 依赖与日志
server/node_modules/
*.log
relay.log
relay.err.log

# ── 系统垃圾
Thumbs.db
desktop.ini
.DS_Store

